{
  "name": "@oheco/dsh-service-tier",
  "version": "0.2.1",
  "description": "Protocol-based processing modes with child-agent inheritance for existing DSH connections",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["index.js", "adapter.js", "core.js", "client.js", "cordis.patch.yml", "locale", "README.md", "LICENSE"],
  "scripts": { "check": "node --check index.js && node --check adapter.js && node --check core.js && node --check client.js", "test": "node --import ./test/runtime-loader.js --test test/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"] }
  }
}
